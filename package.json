{
  "name": "qwitness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keygen": "tsx scripts/keygen.ts",
    "mcp": "tsx --env-file=.env.local mcp/server.ts",
    "verify": "tsx scripts/verify.ts",
    "build:verifier": "tsx scripts/build-verifier.ts",
    "test:e2e": "playwright test",
    "test:mcp": "node --env-file-if-exists=.env.local --env-file-if-exists=.secrets/signing.env --import tsx scripts/mcp-smoke.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "scan:secrets": "tsx scripts/secret-scan.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "canonicalize": "5.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}

# Copy to .env.local. Never commit real values. Do not use NEXT_PUBLIC_ for secrets.
GRAPH_API_KEY=
# Optional: one provider only. MCP client integration also works without an LLM key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Generated by npm run keygen; use server-side Vercel Secrets for deployment.
QWITNESS_SIGNING_SEED=
